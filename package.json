{
  "name": "pdd-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "2D-игра для подготовки к теории на права (билеты ПДД A, B, M)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "import": "tsx scripts/import.ts",
    "mapping": "tsx scripts/mapping.ts",
    "validate": "tsx scripts/validate.ts",
    "coverage": "tsx scripts/coverage.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "icons": "tsx scripts/icons.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
