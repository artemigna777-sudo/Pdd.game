// Настройки для загрузки посредника в Cloudflare (.github/workflows/stats-worker.yml, `wrangler deploy`).
// Имя — как у Worker, который Артём создал в Cloudflare: загрузка заменяет его код, секреты остаются.
{
  "name": "kurier-pdd-stats",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true
}
